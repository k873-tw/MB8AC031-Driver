<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: MIT
     Settings shared by the projects in MB8CFW.sln.
     LIBUSB_ROOT: the unpacked libusb Windows release (libusb-1.0.xx.7z).
     Pass it on the msbuild command line (/p:LIBUSB_ROOT=...) or set it as an
     environment variable; the default is ..\third_party\libusb. -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <LIBUSB_ROOT Condition="'$(LIBUSB_ROOT)' == ''">$(MSBuildThisFileDirectory)..\third_party\libusb</LIBUSB_ROOT>
    <LIBUSB_VS Condition="'$(LIBUSB_VS)' == ''">VS2022</LIBUSB_VS>
    <LibusbArch Condition="'$(Platform)' == 'x64'">MS64</LibusbArch>
    <LibusbArch Condition="'$(Platform)' == 'Win32'">MS32</LibusbArch>
    <OutDir>$(MSBuildThisFileDirectory)..\build-msvc\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)..\build-msvc\obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\include;$(LIBUSB_ROOT)\include;$(LIBUSB_ROOT)\include\libusb-1.0;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32_LEAN_AND_MEAN;_CRT_SECURE_NO_WARNINGS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard_C>stdc11</LanguageStandard_C>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)' == 'Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
</Project>
