# SPDX-License-Identifier: MIT
# Tuners running MB8AC031-CFW: let the logged-in user and the "video"
# group open them (the recorder; pcscd runs as root for the card slot).
SUBSYSTEM!="usb", GOTO="mb8cfw_end"
ENV{DEVTYPE}!="usb_device", GOTO="mb8cfw_end"

# GV-M2TV
ATTR{idVendor}=="04bb", ATTR{idProduct}=="053a", MODE="0660", GROUP="video", TAG+="uaccess"
# PIX-DT295
ATTR{idVendor}=="06b8", ATTR{idProduct}=="103b", MODE="0660", GROUP="video", TAG+="uaccess"

LABEL="mb8cfw_end"
